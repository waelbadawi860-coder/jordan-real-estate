# Copy this file to .env.local and fill in the values.
# .env.local is NEVER uploaded to GitHub.

# --- Public (visible in the browser; protected by database security rules) ---
# Supabase dashboard > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional map tiles. Leave empty on your computer (free OpenStreetMap tiles are
# used for development only). In production maps stay hidden until these are set
# to a commercial provider — see docs/STAGE-7-PROVIDERS.md.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# "live" ONLY on the real public site. Anything else (or empty) = test copy:
# hidden from search engines, relaxed rules for testing.
SITE_STAGE=

# --- SECRET (server only; never share, never paste into chat or GitHub) ---
# Supabase dashboard > Project Settings > API Keys > Secret key (or legacy "service_role")
SUPABASE_SECRET_KEY=

# Random text (at least 16 characters) that protects the daily photo clean-up
# job. Vercel Cron sends it automatically once it is set in Vercel. SECRET.
CRON_SECRET=
